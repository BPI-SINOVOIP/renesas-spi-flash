; Copyright (C) 2024 Renesas Electronics Corp.
;
; ##################### Macro Parameters ############################

; This is the Flash Writer S-record.
; If this parameter is set to "", Flash Writer is not sent and is
; expected to be already running.
FLASH_WRITER = "Flash_Writer_SCIF_RZG3L_SMARC_LPDDR4.mot"

; COM port
COM = 3

; Directory containing binaries
DIR = "..\bootloader\g3l\sdk1.0\"

; Binary files
BL2_FILE = "bl2_bp_spi-bananapi-g3l.srec"
FIP_FILE = "fip-bananapi-g3l.srec"

; Remove user dialogs apart from errors
; 1 to remove dialogs, 0 to keep them
UNATTENDED = 1

; Check if COM port number is passed via parameter, else use definition above
comstr = '/C='
if paramcnt > 1 then
   strconcat comstr params[2]
else
   int2str comport COM
   strconcat comstr comport
endif

connect comstr

testlink
if result = 0 then
   messagebox "No COM port" "Error!"
   disconnect 0
   closett
   end
   exit
endif
if result = 1 then
   messagebox "No connection to COM port, is COM port already open?" "Error!"
   disconnect 0
   closett
   end
   exit
endif

; Baud rate = 115200
setbaud 115200

; Get current base path
getdir BASE_PATH
strconcat BASE_PATH "\"

IMAGE_NUM = 2

strdim FLASH_ADDRESS_TABLE IMAGE_NUM
strdim FILE_NAME_TABLE IMAGE_NUM
strdim TOP_ADDRESS_TABLE IMAGE_NUM

; RZ/G3L SPI Flash addresses
FLASH_ADDRESS_TABLE[0] = "00000"
FLASH_ADDRESS_TABLE[1] = "60000"

; RZ/G3L RAM load addresses
TOP_ADDRESS_TABLE[0] = "21E00"
TOP_ADDRESS_TABLE[1] = "00000"

filenamebl2 = DIR
filenamefip = DIR

extpatbl2 = BL2_FILE
strinsert extpatbl2 1 DIR
extpatfip = FIP_FILE
strinsert extpatfip 1 DIR

; Find BL2 S-record
findfirst dh extpatbl2 filename
if dh = -1 then
   messagebox "BL2 file does not exist. Please copy a valid BL2 file to the binary directory." "Error!"
   exit
endif
strconcat filenamebl2 filename

strscan filenamebl2 ".srec"
if result <> 0 then
   FILE_NAME_TABLE[0] = filenamebl2
else
   messagebox "BL2 must be an S-record file." "Error!"
   exit
endif

; Find FIP S-record
findfirst dh extpatfip filename
if dh = -1 then
   messagebox "FIP file does not exist. Please copy a valid FIP file to the binary directory." "Error!"
   exit
endif
strconcat filenamefip filename

strscan filenamefip ".srec"
if result <> 0 then
   FILE_NAME_TABLE[1] = filenamefip
else
   messagebox "FIP must be an S-record file." "Error!"
   exit
endif

findclose dh

; ##############################################################
; FLASH_WRITE.mot
; ##############################################################

strlen FLASH_WRITER
if result = 0 then
   if UNATTENDED = 0 then
      messagebox "Please make sure that Flash Writer is already running " "User input needed"
   endif
else
   if UNATTENDED = 0 then
      messagebox "Please configure SCIF boot [OFF-ON-OFF-ON] and then reset the board " "User input needed"
      waitregex "-- Load Program to SRAM ---------------"
   endif
   FLASH_WRITER_PATH = BASE_PATH
   strconcat FLASH_WRITER_PATH DIR
   strconcat FLASH_WRITER_PATH FLASH_WRITER
   sendfile FLASH_WRITER_PATH 0
endif

setsync 1
waitregex ">"

for i 0 IMAGE_NUM-1
   FLASH_ADDRESS = FLASH_ADDRESS_TABLE[i]
   TOP_ADDRESS = TOP_ADDRESS_TABLE[i]
   FILE_NAME = FILE_NAME_TABLE[i]
   call write_flash
next

messagebox "Macro executed successfully" "Done!"
sendln "RESET"

disconnect 0
closett
end
exit

; ##############################################################
; XLS2
; ##############################################################

:launch_writer
sendln "XLS2"
waitregex "Please Input"
return

; #############################################################
;  PROGRAM_ADDRESS
;  BASE_PATH
;  FLASH_ADDRESS
;  FILE_NAME
; #############################################################

:write_flash
call launch_writer

sendln TOP_ADDRESS
waitregex "Please Input"
sendln FLASH_ADDRESS
waitregex "please send"

FILE_PATH = BASE_PATH
strconcat FILE_PATH FILE_NAME
sendfile FILE_PATH 0

waitregex ">"
return
